diff --git a/packages/ai/src/api/anthropic-oauth-middleware.ts b/packages/ai/src/api/anthropic-oauth-middleware.ts
new file mode 100644
index 0000000..4c90a21
--- /dev/null
+++ b/packages/ai/src/api/anthropic-oauth-middleware.ts
@@ -0,0 +1,42 @@
+import type { AnthropicOptions } from "./anthropic-messages.ts";
+import type { Model, TranscriptContext } from "../types.ts";
+
+/** A request-scoped addition to Pi's built-in Anthropic OAuth transport. */
+export type AnthropicOAuthRequestMiddleware = (
+	model: Model<"anthropic-messages">,
+	context: TranscriptContext,
+	options: AnthropicOptions | undefined,
+) => AnthropicOptions | undefined;
+
+const middleware = new Map<string, AnthropicOAuthRequestMiddleware>();
+
+export function getAnthropicOAuthToken(options: AnthropicOptions | undefined): string | undefined {
+	if (options?.apiKey) return options.apiKey.includes("sk-ant-oat") ? options.apiKey : undefined;
+	for (const [name, value] of Object.entries(options?.headers ?? {})) {
+		if (name.toLowerCase() !== "authorization" || typeof value !== "string") continue;
+		const token = /^Bearer\s+(sk-ant-oat\S*)$/i.exec(value)?.[1];
+		if (token) return token;
+	}
+	return undefined;
+}
+
+export function registerAnthropicOAuthRequestMiddleware(
+	sourceId: string,
+	callback: AnthropicOAuthRequestMiddleware,
+): () => void {
+	middleware.set(sourceId, callback);
+	return () => {
+		if (middleware.get(sourceId) === callback) middleware.delete(sourceId);
+	};
+}
+
+export function applyAnthropicOAuthRequestMiddleware(
+	model: Model<"anthropic-messages">,
+	context: TranscriptContext,
+	options: AnthropicOptions | undefined,
+): AnthropicOptions | undefined {
+	if (model.provider !== "anthropic" || !getAnthropicOAuthToken(options)) return options;
+	let current = options;
+	for (const callback of middleware.values()) current = callback(model, context, current);
+	return current;
+}
